{
  "expo": {
    "name": "Postklar",
    "slug": "postklar",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F3D47"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.postklar.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Postklar nutzt die Kamera, um Briefe zu fotografieren und zu analysieren.",
        "NSPhotoLibraryUsageDescription": "Postklar kann Fotos aus Ihrer Bibliothek öffnen, um Briefe zu analysieren.",
        "NSMicrophoneUsageDescription": "Für die Kamerafunktion wird gelegentlich auf das Mikrofon zugegriffen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F3D47"
      },
      "package": "de.postklar.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Postklar nutzt die Kamera, um Briefe zu fotografieren."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Postklar kann Fotos aus Ihrer Bibliothek öffnen."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F3D47"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "postklar",
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
