# ─────────────────────────────────────────────────────────────────────────────
# PostScout – Umgebungsvariablen
# ─────────────────────────────────────────────────────────────────────────────
# 1. Diese Datei kopieren: cp .env.local.example .env.local
# 2. Alle Werte ausfüllen (niemals die .env.local in Git pushen!)
# 3. Dieselben Werte in Vercel unter Settings → Environment Variables eintragen
# ─────────────────────────────────────────────────────────────────────────────

# ── SUPABASE ──────────────────────────────────────────────────────────────────
# Wo: supabase.com → Dein Projekt → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=DEIN-ANON-KEY

# ── ANTHROPIC (Claude API) ────────────────────────────────────────────────────
# Wo: console.anthropic.com → API Keys → Create Key
# WICHTIG: Kein NEXT_PUBLIC_ Prefix → bleibt serverseitig, nie im Browser!
ANTHROPIC_API_KEY=sk-ant-DEIN-KEY
